# Server-side only. Leave blank for local simulation without Meta.
MODEL_API_KEY=
META_PARSE_MODEL=muse-spark-1.3
PORT=8787
# Optional server-side ISO timestamp to stop paid operations after judging.
# Example: 2026-11-09T23:59:59+05:30
META_ACCESS_UNTIL=

# Optional exact frontend origin when using a separate GitHub Pages frontend.
PUBLIC_APP_ORIGIN=
